rules_version = '2';

// Reglas de seguridad de Firestore para FinanzApp.
// Cada usuario solo puede leer/escribir SUS propios datos (bajo users/{su-uid}).
// Pega estas reglas en: Firebase Console → Firestore Database → pestaña "Reglas".
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
